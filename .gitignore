# Built programs and whatever a run leaves behind, saved depth maps and point clouds among it (out/run/map.*).
out/
compile_commands.json
.cache/

# Never published: these describe a private room. What the cameras saw, the landmarks read from it, poses, the
# cameras' serial numbers, live logs of where things moved. input/calib/README.md says what belongs here.
input/calib/*
!input/calib/README.md
logs/live/
input/refs/*/

